[conf]
user.aswf:osl_clang_ref=clang/[[ clang_versions[versions.ASWF_OSL_CLANG_MAJOR_VERSION] ]]@{{ org }}/[[ conan_channel ]]
user.aswf:pyside_clang_ref=clang/[[ clang_versions[versions.ASWF_PYSIDE_CLANG_MAJOR_VERSION] ]]@{{ org }}/[[ conan_channel ]]
user.aswf:ispc_clang_ref=clang/[[ clang_versions[versions.ASWF_ISPC_CLANG_MAJOR_VERSION] ]]@{{ org }}/[[ conan_channel ]]
user.aswf:openimagedenoise_clang_ref=clang/[[ clang_versions[versions.ASWF_OPENIMAGEDENOISE_CLANG_MAJOR_VERSION] ]]@{{ org }}/[[ conan_channel ]]
user.aswf:openvdb_clang_ref=clang/[[ clang_versions[versions.ASWF_OPENVDB_CLANG_MAJOR_VERSION] ]]@{{ org }}/[[ conan_channel ]]
# mesa's swrast/llvmpipe driver must share one LLVM instance with
# osl/openvdb/openimagedenoise in the same process (two different libLLVM
# SONAMEs loaded together abort with "Option ... already exists!") -- alias
# straight to osl's major version instead of adding a separate
# ASWF_MESA_CLANG_MAJOR_VERSION key that could drift out of sync with it.
user.aswf:mesa_clang_ref=clang/[[ clang_versions[versions.ASWF_OSL_CLANG_MAJOR_VERSION] ]]@{{ org }}/[[ conan_channel ]]
