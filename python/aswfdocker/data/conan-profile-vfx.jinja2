{% set org = os.getenv("ASWF_PKG_ORG", "aswf") %}
[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=[[ versions.ASWF_GCC_VERSION ]]
compiler.libcxx=libstdc++11
compiler.cppstd=[[ versions.ASWF_CXX_STANDARD ]]
build_type=Release
[% if versions.ASWF_CXX_STANDARD == "20" %]
# Qt 6.6 and newer must be compiled with -std=gnu20++ to support 128 bit integers
qt/*:compiler.cppstd=gnu20
[% endif %]
[options]
# Build everything as shared libs by default
*:shared=True
[tool_requires]
[replace_requires]
